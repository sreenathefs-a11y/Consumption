function mapPayload_(body,mapping){var patch={};Object.keys(mapping).forEach(function(key){if(body[key]!==undefined)patch[mapping[key]]=body[key];});return patch;}
function createAudited_(key,record,entityType,body){assertUniqueId_(key,record[CONFIG.IDS[key]]);appendRecord_(key,record);var audit=appendAudit_({user:body.enteredBy||body.uploader||body.updatedBy||body.confirmedBy||body.closureApprover,action:'CREATE',entityType:entityType,entityId:record[CONFIG.IDS[key]],newValue:record,remarks:body.auditRemarks});return {record:record,auditLogId:audit.Log_ID};}
function updateAudited_(key,id,patch,entityType,body){var result=updateRecord_(key,id,patch);var audit=appendAudit_({user:body.enteredBy||body.updatedBy||body.confirmedBy||body.closureApprover,action:'UPDATE',entityType:entityType,entityId:id,oldValue:result.oldValue,newValue:result.newValue,remarks:body.auditRemarks});return {record:result.newValue,auditLogId:audit.Log_ID};}
